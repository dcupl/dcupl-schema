        "AppLoaderConfiguration.DataResource": {
            "description": "A data resource contains data for a model.",
            "defaultSnippets": {
                "label": "Data",
                "properties": [
                    "url:string:${baseUrl}/data/my-data.json",
                    "type:data",
                    "model",
                    "tags:array"
                ]
            },
            "title": "AppLoaderConfiguration.DataResource",
            "additionalProperties": false,
            "type": "object",
            "properties": {
                "key": {
                    "type": "string",
                    "title": "key"
                },
                "url": {
                    "type": "string",
                    "title": "url"
