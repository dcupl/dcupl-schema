                "model": {
                    "type": "string",
                    "title": "model"
                },
                "options": {
                    "type": "object",
                    "properties": {
                        "updateType": {
                            "enum": [
                                "remove",
                                "set",
                                "update",
                                "upsert"
                            ],
                            "type": "string",
                            "title": "updateType"
                        },
                        "keyProperty": {
                            "description": "Property name(s) on each row that uniquely identify it.\n\nPass a single string for a simple key (`keyProperty: 'ID'`) or a\nnon-empty array for a composite key (`keyProperty: ['ID', 'Language']`).\nComposite parts are joined into the internal `.key` using\n`keyPropertySeparator` (default `::`). Order is preserved literally.\n\nEach part is stringified via `String(value)`, so `null`, `undefined`,\nand `''` produce distinct keys (`'null'`, `'undefined'`, `''`).",
                            "anyOf": [
                                {
                                    "type": "array",
                                    "items": {
                                        "type": "string"
                                    }
                                },
                                {
                                    "type": "string"
                                }
                            ],
                            "title": "keyProperty"
                        },
                        "keyPropertySeparator": {
                            "description": "Separator joining composite `keyProperty` parts. Default `'::'`.\nIgnored when `keyProperty` is a string or a single-element array.",
                            "type": "string",
                            "title": "keyPropertySeparator"
                        },
                        "autoGenerateKey": {
                            "type": "boolean",
                            "title": "autoGenerateKey"
                        },
                        "autoGenerateProperties": {
                            "description": "Configures how property auto-generation inspects input data.\n\n- `true` / `false`: enable/disable auto-generation. When enabled with `true`,\n  only the first row of input data is inspected (fast, default behavior).\n- Object form lets you scan more rows:\n  - `deep: true` walks every row and reconciles types across them.\n  - `sampleSize: N` walks at most N rows (implies deep). Useful for large datasets\n    where row 1 alone may not represent the schema.\n\nWhen more than one row is scanned, empty values (`null`, `undefined`, `''`)\nare ignored during inference so a single blank cell does not poison a column's type.",
                            "anyOf": [
                                {
                                    "type": "object",
                                    "properties": {
                                        "deep": {
                                            "type": "boolean",
                                            "title": "deep"
                                        },
                                        "sampleSize": {
                                            "type": "number",
                                            "title": "sampleSize"
                                        }
                                    },
                                    "additionalProperties": false
                                },
                                {
                                    "type": "boolean"
                                }
                            ],
                            "title": "autoGenerateProperties"
                        },
                        "csvParserOptions": {
                            "type": "object",
                            "properties": {
                                "delimiter": {
                                    "type": "string",
                                    "title": "delimiter"
                                },
                                "quoteChar": {
                                    "type": "string",
                                    "title": "quoteChar"
                                },
                                "escapeChar": {
                                    "type": "string",
                                    "title": "escapeChar"
                                },
                                "commentChar": {
                                    "type": "string",
                                    "title": "commentChar"
                                }
                            },
                            "additionalProperties": false,
                            "title": "csvParserOptions"
                        }
                    },
                    "additionalProperties": false,
                    "title": "options"
                }
            },
