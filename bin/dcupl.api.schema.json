{
    "type": "object",
    "properties": {
        "key": {
            "type": "string",
            "minLength": 1,
            "description": "API key",
            "title": "key"
        },
        "dcuplConfig": {
            "type": "object",
            "properties": {
                "projectId": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Dcupl project ID",
                    "title": "projectId"
                },
                "apiKey": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Dcupl API key",
                    "title": "apiKey"
                },
                "processOptions": {
                    "type": "object",
                    "properties": {
                        "applicationKey": {
                            "type": "string",
                            "title": "applicationKey"
                        },
                        "environmentKeys": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            },
                            "title": "environmentKeys"
                        },
                        "resourceTags": {
                            "type": "array",
                            "items": {
                                "anyOf": [
                                    {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        }
                                    },
                                    {
                                        "type": "string"
                                    }
                                ]
                            },
                            "title": "resourceTags"
                        },
                        "variables": {
                            "type": "array",
                            "items": {
                                "defaultSnippets": {
                                    "label": "Variable",
                                    "properties": [
                                        "key",
                                        "description",
                                        "value:string"
                                    ]
                                },
                                "type": "object",
                                "properties": {
                                    "key": {
                                        "type": "string",
                                        "title": "key"
                                    },
                                    "description": {
                                        "type": "string",
                                        "title": "description"
                                    },
                                    "value": {
                                        "type": "string",
                                        "title": "value"
                                    }
                                },
                                "additionalProperties": false,
                                "required": [
                                    "key"
                                ]
                            },
                            "title": "variables"
                        },
                        "options": {
                            "type": "object",
                            "properties": {
                                "defaultDataContainerUpdateType": {
                                    "enum": [
                                        "remove",
                                        "set",
                                        "update",
                                        "upsert"
                                    ],
                                    "type": "string",
                                    "title": "defaultDataContainerUpdateType"
                                },
                                "csvParserOptions": {
                                    "type": "object",
                                    "properties": {
                                        "delimiter": {
                                            "type": "string",
                                            "title": "delimiter"
                                        },
                                        "quoteChar": {
                                            "type": "string",
                                            "title": "quoteChar"
                                        },
                                        "escapeChar": {
                                            "type": "string",
                                            "title": "escapeChar"
                                        },
                                        "commentChar": {
                                            "type": "string",
                                            "title": "commentChar"
                                        }
                                    },
                                    "additionalProperties": false,
                                    "title": "csvParserOptions"
                                },
                                "missingModelHandling": {
                                    "type": "object",
                                    "properties": {
                                        "autoGenerateProperties": {
                                            "description": "Configures how property auto-generation inspects input data.\n\n- `true` / `false`: enable/disable auto-generation. When enabled with `true`,\n  only the first row of input data is inspected (fast, default behavior).\n- Object form lets you scan more rows:\n  - `deep: true` walks every row and reconciles types across them.\n  - `sampleSize: N` walks at most N rows (implies deep). Useful for large datasets\n    where row 1 alone may not represent the schema.\n\nWhen more than one row is scanned, empty values (`null`, `undefined`, `''`)\nare ignored during inference so a single blank cell does not poison a column's type.",
                                            "anyOf": [
                                                {
                                                    "type": "object",
                                                    "properties": {
                                                        "deep": {
                                                            "type": "boolean",
                                                            "title": "deep"
                                                        },
                                                        "sampleSize": {
                                                            "type": "number",
                                                            "title": "sampleSize"
                                                        }
                                                    },
                                                    "additionalProperties": false
                                                },
                                                {
                                                    "type": "boolean"
                                                }
                                            ],
                                            "title": "autoGenerateProperties"
                                        }
                                    },
                                    "additionalProperties": false,
                                    "title": "missingModelHandling"
                                }
                            },
                            "additionalProperties": false,
                            "title": "options"
                        }
                    },
                    "additionalProperties": false,
                    "description": "Dcupl process options",
                    "title": "processOptions"
                },
                "loaderFetchOptions": {
                    "type": "object",
                    "properties": {
                        "baseUrl": {
                            "description": "The base URL to use for all resources\nIf not set the baseUrl points to the draft version of the CDN",
                            "type": "string",
                            "title": "baseUrl"
                        },
                        "loaderFileName": {
                            "description": "The name of the loader file to use\nIf not set the loader file is named 'dcupl.lc.json'",
                            "type": "string",
                            "title": "loaderFileName"
                        },
                        "headers": {
                            "description": "Custom Headers used for fetching the loader file\nFor example authorization headers",
                            "type": "array",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "key": {
                                        "type": "string",
                                        "title": "key"
                                    },
                                    "value": {
                                        "type": "string",
                                        "title": "value"
                                    }
                                },
                                "additionalProperties": false,
                                "required": [
                                    "key",
                                    "value"
                                ]
                            },
                            "title": "headers"
                        },
                        "skipApply": {
                            "description": "If set to false the fetched config is not applied to the loader but only returned",
                            "type": "boolean",
                            "title": "skipApply"
                        }
                    },
                    "additionalProperties": false,
                    "description": "Dcupl loader fetch options",
                    "title": "loaderFetchOptions"
                }
            },
            "required": [
                "projectId",
                "apiKey",
                "processOptions"
            ],
            "additionalProperties": false,
            "description": "Dcupl configuration",
            "title": "dcuplConfig"
        },
        "vGuardEnabled": {
            "type": "boolean",
            "description": "Version guard enabled",
            "title": "vGuardEnabled"
        },
        "auth": {
            "description": "Authentication configuration",
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "type": {
                        "type": "string",
                        "const": "api-key",
                        "description": "Authentication type",
                        "title": "type"
                    },
                    "value": {
                        "type": "string",
                        "minLength": 1,
                        "description": "API key value",
                        "title": "value"
                    }
                },
                "required": [
                    "type",
                    "value"
                ],
                "additionalProperties": false
            },
            "title": "auth"
        },
        "name": {
            "description": "Human-readable name",
            "type": "string",
            "title": "name"
        },
        "description": {
            "description": "Description",
            "type": "string",
            "title": "description"
        },
        "version": {
            "description": "Template version",
            "type": "string",
            "title": "version"
        },
        "endpoints": {
            "description": "Scripted endpoints served under the endpoints/ prefix",
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "path": {
                        "type": "string",
                        "pattern": "^(:?[A-Za-z0-9_.~-]+)(\\/:?[A-Za-z0-9_.~-]+)*$",
                        "description": "Endpoint path relative to the instance endpoints/ prefix, :name segments are path params",
                        "title": "path"
                    },
                    "method": {
                        "type": "string",
                        "enum": [
                            "GET",
                            "POST"
                        ],
                        "description": "HTTP method",
                        "title": "method"
                    },
                    "scriptKey": {
                        "type": "string",
                        "minLength": 1,
                        "description": "scriptKey of the type: script loader resource that answers the request",
                        "title": "scriptKey"
                    },
                    "description": {
                        "description": "Description",
                        "type": "string",
                        "title": "description"
                    }
                },
                "required": [
                    "path",
                    "method",
                    "scriptKey"
                ],
                "additionalProperties": false,
                "defaultSnippets": {
                    "label": "Endpoint",
                    "properties": [
                        "path",
                        "method:GET",
                        "scriptKey",
                        "description"
                    ]
                }
            },
            "title": "endpoints"
        },
        "mcp": {
            "description": "Model Context Protocol endpoint of the instance, absent = off",
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean",
                    "description": "Serve the MCP endpoint (POST instance/:key/mcp) for this instance. Needs the project feature MCP_ENABLED",
                    "title": "enabled"
                }
            },
            "required": [
                "enabled"
            ],
            "additionalProperties": false,
            "title": "mcp"
        }
    },
    "required": [
        "key",
        "dcuplConfig",
        "vGuardEnabled"
    ],
    "additionalProperties": false,
    "$schema": "http://json-schema.org/draft-07/schema#"
}
