{
    "type": "object",
    "properties": {
        "key": {
            "type": "string",
            "title": "key"
        },
        "dcuplConfig": {
            "type": "object",
            "properties": {
                "projectId": {
                    "type": "string",
                    "title": "projectId"
                },
                "apiKey": {
                    "type": "string",
                    "title": "apiKey"
                },
                "processOptions": {
                    "type": "object",
                    "properties": {
                        "applicationKey": {
                            "type": "string",
                            "title": "applicationKey"
                        },
                        "environmentKeys": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            },
                            "title": "environmentKeys"
                        },
                        "resourceTags": {
                            "type": "array",
                            "items": {
                                "anyOf": [
                                    {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        }
                                    },
                                    {
                                        "type": "string"
                                    }
                                ]
                            },
                            "title": "resourceTags"
                        },
                        "variables": {
                            "type": "array",
                            "items": {
                                "defaultSnippets": [
                                    {
                                        "label": "Variable",
                                        "body": {
                                            "key": "$1",
                                            "description": "$2",
                                            "value": "^\"\""
                                        }
                                    }
                                ],
                                "type": "object",
                                "properties": {
                                    "key": {
                                        "type": "string",
                                        "title": "key"
                                    },
                                    "description": {
                                        "type": "string",
                                        "title": "description"
                                    },
                                    "value": {
                                        "type": "string",
                                        "title": "value"
                                    }
                                },
                                "additionalProperties": false,
                                "required": [
                                    "key",
                                    "value"
                                ]
                            },
                            "title": "variables"
                        },
                        "options": {
                            "type": "object",
                            "properties": {
                                "defaultDataContainerUpdateType": {
                                    "enum": [
                                        "remove",
                                        "set",
                                        "update",
                                        "upsert"
                                    ],
                                    "type": "string",
                                    "title": "defaultDataContainerUpdateType"
                                },
                                "csvParserOptions": {
                                    "type": "object",
                                    "properties": {
                                        "delimiter": {
                                            "type": "string",
                                            "title": "delimiter"
                                        },
                                        "quoteChar": {
                                            "type": "string",
                                            "title": "quoteChar"
                                        },
                                        "escapeChar": {
                                            "type": "string",
                                            "title": "escapeChar"
                                        }
                                    },
                                    "additionalProperties": false,
                                    "title": "csvParserOptions"
                                },
                                "missingModelHandling": {
                                    "type": "object",
                                    "properties": {
                                        "autoGenerateProperties": {
                                            "type": "boolean",
                                            "title": "autoGenerateProperties"
                                        }
                                    },
                                    "additionalProperties": false,
                                    "title": "missingModelHandling"
                                }
                            },
                            "additionalProperties": false,
                            "title": "options"
                        }
                    },
                    "additionalProperties": false,
                    "title": "processOptions"
                },
                "loaderFetchOptions": {
                    "type": "object",
                    "properties": {
                        "baseUrl": {
                            "description": "The base URL to use for all resources\nIf not set the baseUrl points to the draft version of the CDN",
                            "type": "string",
                            "title": "baseUrl"
                        },
                        "loaderFileName": {
                            "description": "The name of the loader file to use\nIf not set the loader file is named 'dcupl.lc.json'",
                            "type": "string",
                            "title": "loaderFileName"
                        },
                        "headers": {
                            "description": "Custom Headers used for fetching the loader file\nFor example authorization headers",
                            "type": "array",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "key": {
                                        "type": "string",
                                        "title": "key"
                                    },
                                    "value": {
                                        "type": "string",
                                        "title": "value"
                                    }
                                },
                                "additionalProperties": false,
                                "required": [
                                    "key",
                                    "value"
                                ]
                            },
                            "title": "headers"
                        },
                        "skipApply": {
                            "description": "If set to false the fetched config is not applied to the loader but only returned",
                            "type": "boolean",
                            "title": "skipApply"
                        }
                    },
                    "additionalProperties": false,
                    "title": "loaderFetchOptions"
                }
            },
            "additionalProperties": false,
            "required": [
                "apiKey",
                "processOptions",
                "projectId"
            ],
            "title": "dcuplConfig"
        },
        "vGuardEnabled": {
            "type": "boolean",
            "title": "vGuardEnabled"
        },
        "auth": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "type": {
                        "type": "string",
                        "const": "api-key",
                        "title": "type"
                    },
                    "value": {
                        "type": "string",
                        "title": "value"
                    }
                },
                "additionalProperties": false,
                "required": [
                    "type",
                    "value"
                ]
            },
            "title": "auth"
        },
        "name": {
            "type": "string",
            "title": "name"
        },
        "description": {
            "type": "string",
            "title": "description"
        },
        "version": {
            "type": "string",
            "title": "version"
        },
        "endpoints": {
            "description": "Scripted endpoints served under instance/<key>/x/<path>, each answered by a type: 'script' loader resource (dcupl-app-runner#88).",
            "type": "array",
            "items": {
                "defaultSnippets": [
                    {
                        "label": "Endpoint",
                        "body": {
                            "path": "$1",
                            "method": "GET",
                            "scriptKey": "$2",
                            "description": "$3"
                        }
                    }
                ],
                "type": "object",
                "properties": {
                    "path": {
                        "description": "URL-safe path relative to the instance's x/ prefix: no leading slash, segments separated by /, a segment starting with : is a path parameter (orders, orders/:id/summary). method + path must be unique within the template.",
                        "type": "string",
                        "pattern": "^(:?[A-Za-z0-9_.~-]+)(/:?[A-Za-z0-9_.~-]+)*$",
                        "title": "path"
                    },
                    "method": {
                        "description": "HTTP method the endpoint answers. The runner serves GET and POST.",
                        "enum": [
                            "GET",
                            "POST"
                        ],
                        "type": "string",
                        "title": "method"
                    },
                    "scriptKey": {
                        "description": "The scriptKey of a type: 'script' resource in the loader configuration. Only listed scripts are callable; the script runs in endpoint mode with the request.",
                        "type": "string",
                        "minLength": 1,
                        "title": "scriptKey"
                    },
                    "description": {
                        "description": "Shown as the operation summary in the instance's Swagger document and the console's API tester.",
                        "type": "string",
                        "title": "description"
                    }
                },
                "additionalProperties": false,
                "required": [
                    "path",
                    "method",
                    "scriptKey"
                ]
            },
            "title": "endpoints"
        }
    },
    "additionalProperties": false,
    "required": [
        "dcuplConfig",
        "key",
        "vGuardEnabled"
    ],
    "$schema": "http://json-schema.org/draft-07/schema#"
}